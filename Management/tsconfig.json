{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],

    /* Incremental migration: existing .jsx/.js keep compiling untyped
       until explicitly renamed to .tsx/.ts. Do not flip checkJs on
       until the whole app has been migrated (see Phase 6 strictness ramp
       in UI_REWRITE_PROGRESS.md) — turning it on early would flood every
       untouched file with errors unrelated to whatever is being worked on. */
    "allowJs": true,
    "checkJs": false,

    /* Non-strict for now, ramped up per UI_REWRITE_PROGRESS.md Phase 0.5:
       tightened once Phase 2 primitives are fully typed, full strict
       mode only after every feature folder is migrated (Phase 6). */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./src/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src"]
}
