# This repo's dependency tree has pre-existing peer-dependency conflicts
# (vite@8 vs @vitejs/plugin-react's peer range; date-fns@2 vs @base-ui/react's
# optional peer on date-fns@4) that predate the design-system rewrite and
# aren't being resolved as part of it. legacy-peer-deps keeps plain `npm
# install` — including the ones shadcn's own CLI shells out to internally
# when adding components — working without needing --legacy-peer-deps typed
# out by hand every time.
legacy-peer-deps=true
