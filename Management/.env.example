# Management App Environment Variables - Example
# Copy this file to .env.local and fill in the values

# ==========================================
# API Configuration
# ==========================================
VITE_API_URL=http://localhost:3000/api/v1
VITE_IMGBB_API_KEY=your_imgbb_api_key_here

# ==========================================
# APP Configuration
# ==========================================
VITE_APP_NAME=Travel CRM Management
VITE_APP_VERSION=1.0.0

# ==========================================
# COMPANY BRANDING (Customize for each client)
# ==========================================
VITE_COMPANY_NAME=Your Company Name
VITE_COMPANY_SHORT_NAME=YCN
VITE_COMPANY_TAGLINE=Your Travel Partner
VITE_COMPANY_LEGAL_NAME=Your Company Pvt. Ltd.

# Contact Information
VITE_COMPANY_EMAIL=info@yourcompany.com
VITE_SUPPORT_EMAIL=support@yourcompany.com
VITE_COMPANY_PHONE=+1-800-000-0000

# Website
VITE_COMPANY_WEBSITE=https://www.yourcompany.com

# ==========================================
# OPTIONAL: Development Settings
# ==========================================
# Set to 'true' to show test credentials on login page (development only)
VITE_SHOW_TEST_CREDENTIALS=false
