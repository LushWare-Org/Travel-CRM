# Client App Environment Variables - Example
# Copy this file to .env.local and fill in the values

# ==========================================
# API Configuration
# ==========================================
VITE_API_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT=15000

# Note: the browser tab title is set directly in Client/index.html's
# <title> tag (Vite has no fallback syntax for unset HTML env vars) -
# edit that file per deployment instead of an env var here.

# ==========================================
# COMPANY BRANDING (Customize for each client)
# ==========================================
VITE_COMPANY_NAME=Your Company
VITE_COMPANY_SHORT_NAME=YC
VITE_COMPANY_TAGLINE=Your Travel Partner
VITE_COMPANY_LEGAL_NAME=Your Company
VITE_COMPANY_FOUNDED_YEAR=2021

# Contact Information
VITE_COMPANY_EMAIL=info@yourcompany.com
VITE_SUPPORT_EMAIL=support@yourcompany.com
VITE_COMPANY_PHONE=+1-800-000-0000
VITE_COMPANY_WHATSAPP=+18000000000
VITE_COMPANY_ADDRESS=123 Example Street, City, Country
VITE_COMPANY_OFFICE_HOURS=Mon-Fri, 9AM - 6PM

# Website & Socials (leave blank to hide that icon/link)
VITE_COMPANY_WEBSITE=https://www.yourcompany.com
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_YOUTUBE=

# Legal links (leave blank to hide the footer link)
VITE_LEGAL_PRIVACY_URL=
VITE_LEGAL_TERMS_URL=
VITE_LEGAL_CANCELLATION_URL=

# ==========================================
# Currency
# ==========================================
VITE_CURRENCY_CODE=INR
VITE_CURRENCY_SYMBOL=
VITE_CURRENCY_LOCALE=en-IN

# ==========================================
# Third-party integrations (leave blank to disable the feature)
# ==========================================
VITE_ELFSIGHT_APP_ID=
VITE_IMGBB_API_KEY=
