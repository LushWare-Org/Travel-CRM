# Client App Environment Variables - Lush Theme Example
# Copy this file to .env.lush and fill in the values

# ==========================================
# API Configuration
# ==========================================
VITE_API_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT=15000

# Note: the browser tab title is set directly in Client/index.html's
# <title> tag (Vite has no fallback syntax for unset HTML env vars) -
# edit that file per deployment instead of an env var here.

# Theme selector — build-time switch consumed by src/config/activeTheme.ts
# and tailwind.config.js (see comments in both files).
VITE_THEME=lush

# Fonts (Google Fonts stylesheet URL) and header/favicon logo path — the
# Lush theme uses Fraunces (display) + Inter (body) and its own logo asset.
VITE_GOOGLE_FONTS_URL=https://fonts.googleapis.com/css2?family=Fraunces:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap
VITE_LOGO_PATH=/lush-logo.png

# ==========================================
# COMPANY BRANDING (Customize for each client)
# ==========================================
VITE_COMPANY_NAME=Lushware Travel
VITE_COMPANY_SHORT_NAME=Lushware
VITE_COMPANY_TAGLINE=Journeys, Rooted in Nature
VITE_COMPANY_LEGAL_NAME=Lushware Travel Pvt. Ltd.
VITE_COMPANY_FOUNDED_YEAR=2024

# Contact Information
VITE_COMPANY_EMAIL=hello@lushware.travel
VITE_SUPPORT_EMAIL=support@lushware.travel
VITE_COMPANY_PHONE=+94-11-234-5678
VITE_COMPANY_WHATSAPP=+94112345678
VITE_COMPANY_ADDRESS=42 Rainforest Road, Colombo, Sri Lanka
VITE_COMPANY_OFFICE_HOURS=Mon-Sat, 9AM - 7PM

# Website & Socials (leave blank to hide that icon/link)
VITE_COMPANY_WEBSITE=https://www.lushware.travel
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_YOUTUBE=

# Legal links (leave blank to hide the footer link)
VITE_LEGAL_PRIVACY_URL=
VITE_LEGAL_TERMS_URL=
VITE_LEGAL_CANCELLATION_URL=

# ==========================================
# Currency
# ==========================================
VITE_CURRENCY_CODE=INR
VITE_CURRENCY_SYMBOL=
VITE_CURRENCY_LOCALE=en-IN

# ==========================================
# Third-party integrations (leave blank to disable the feature)
# ==========================================
# Left blank: no review widget configured for the Lush demo, so
# TestimonialsSection simply does not render (its existing behavior).
VITE_ELFSIGHT_APP_ID=
VITE_IMGBB_API_KEY=

# ==========================================
# HTTP client resilience (retries GET/HEAD only by default)
# ==========================================
VITE_API_RETRY_MAX_ATTEMPTS=3
VITE_API_RETRY_BASE_DELAY_MS=300
VITE_API_RETRY_MAX_DELAY_MS=4000
VITE_API_RETRY_METHODS=GET,HEAD
VITE_API_RETRY_STATUS_CODES=408,429,500,502,503,504

# ==========================================
# Page visibility (per-deployment toggles; unset = enabled)
# ==========================================
VITE_FEATURE_CAREER=true
VITE_FEATURE_PLANNER=true
VITE_FEATURE_DESTINATIONS=true
VITE_FEATURE_ABOUT=true
VITE_FEATURE_ACCOUNTS=true

# ==========================================
# Floating action buttons (unset = enabled when the underlying contact
# value is set for whatsapp/call; scrollTop always defaults on)
# ==========================================
VITE_FEATURE_WHATSAPP_BUTTON=true
VITE_FEATURE_CALL_BUTTON=true
VITE_FEATURE_SCROLL_TOP=true

# ==========================================
# SEO
# ==========================================
VITE_META_DESCRIPTION=Lushware Travel — sustainable, expertly curated journeys around the world.
