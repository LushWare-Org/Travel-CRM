PORT=3010
NODE_ENV=development

# Supabase PostgreSQL — same instance as every other service, own schema (crm_flights)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

CLIENT_URL=http://localhost:5173
MANAGEMENT_URL=http://localhost:5174

# ─── Travelport+ ─────────────────────────────────────────────────────────────
# While true, travelport.service.js returns realistic fake offers/bookings
# instead of calling Travelport — lets the whole feature be built/tested
# before sandbox credentials exist. Set to false once the vars below are filled in.
TRAVELPORT_MOCK_MODE=true

TRAVELPORT_ENV=sandbox
TRAVELPORT_TOKEN_URL=
TRAVELPORT_API_BASE_URL=
TRAVELPORT_CLIENT_ID=
TRAVELPORT_CLIENT_SECRET=
TRAVELPORT_ACCESS_GROUP=
TRAVELPORT_TARGET_BRANCH=
