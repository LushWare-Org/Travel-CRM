PORT=3008
NODE_ENV=development

# Facebook Webhook
FACEBOOK_VERIFY_TOKEN=your_verify_token
FACEBOOK_APP_SECRET=your_app_secret
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token

# lead-service (Facebook leads are created via its internal API, not written
# directly to its tables — assignment is governed by lead-service's own
# Settings.assignmentMode, not a separate flag here)
LEAD_SERVICE_URL=http://localhost:3004
INTERNAL_EVENTS_TOKEN=shared_internal_service_token

# Email (Nodemailer) — notification-service is the only service that sends
# email directly; auth-service, booking-service, billing-service, and
# career-service call POST /api/v1/notifications/internal/email instead of
# holding their own SMTP config.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@yourdomain.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
