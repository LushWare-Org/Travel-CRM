# All services share this single PostgreSQL database.
# Each service operates within its own schema namespace.
DATABASE_URL="postgresql://user:password@localhost:5432/travel_crm"

PORT=3006
REDIS_URL=redis://localhost:6379

# user-service — org settings (company/branding/quotation defaults/bank details)
USER_SERVICE_URL=http://localhost:3002
# Must match user-service's INTERNAL_SERVICE_KEY
INTERNAL_SERVICE_KEY=change-me
STRIPE_SECRET_KEY=your_stripe_key
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# WhatsApp (Twilio) — send via WhatsApp for quotations/invoices/receipts.
# While true (default), sends are logged and faked instead of calling Twilio.
# Set to false once the Twilio vars below are filled in.
TWILIO_MOCK_MODE=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
