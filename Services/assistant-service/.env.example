# Supabase PostgreSQL — same instance as every other service, own schema (crm_assistant)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

CLIENT_URL=http://localhost:5173
PORT=3011
GEMINI_API_KEY=your_gemini_api_key
# Optional — defaults to gemini-3.5-flash if unset. Pinned to a specific,
# already-established GA model rather than the floating gemini-flash-latest
# alias (see Services/package-service/src/ai/geminiClient.js for the full
# rationale). Re-check this pin periodically as newer models mature.
# GEMINI_MODEL=gemini-3.5-flash
# Temporary client-first rollout gate. Keep false until the compatible Client
# bundle has propagated; remove after the tested rollback window.
ASSISTANT_CONVERSATIONAL_OUTCOMES_ENABLED=false
# Stage-one classifier configuration. The model is pinned independently from
# the resolver. Direct classes remain disabled until a real sanitized corpus
# passes the documented per-class evaluation gates.
GEMINI_ROUTER_MODEL=gemini-3.5-flash
ASSISTANT_ROUTER_SOCIAL_ENABLED=false
ASSISTANT_ROUTER_OFF_TOPIC_ENABLED=false
ASSISTANT_ROUTER_SOCIAL_THRESHOLD=0.95
ASSISTANT_ROUTER_OFF_TOPIC_THRESHOLD=0.95


# Used by @travel-crm/policy-retrieval's fetchPolicyDocuments (imported by
# this service) to fetch the org's policy documents from user-service.
USER_SERVICE_URL=http://localhost:3002
# Must match user-service's INTERNAL_SERVICE_KEY
INTERNAL_SERVICE_KEY=change-me

# ─── Management Context Copilot (server-side gates) ────────────────────────
# Off by default. When true, the authenticated management/turn route responds.
# PAGE_KEYS is an optional comma-separated allowlist for page-specific rollback
# (empty = all registered pages). A disabled feature returns 404.
MANAGEMENT_COPILOT_ENABLED=false
# MANAGEMENT_COPILOT_PAGE_KEYS=leads,packages,billing
MANAGEMENT_COPILOT_GUIDANCE_ENABLED=false
# Domain-service URLs the copilot adapters/tools read from, under the caller's
# forwarded x-user-* identity.
LEAD_SERVICE_URL=http://localhost:3004
