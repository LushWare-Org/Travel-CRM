// =============================================================
// assistant-service — PostgreSQL schema: "crm_assistant"
// Shared DB, isolated namespace.
//
// Design decisions:
//   • AssistantEvent is a telemetry sink only (impression/opened/turn/
//     response/nav_click/error) — the turn protocol itself is stateless,
//     per docs/designs/site-wide-floating-assistant.md Eng Review Decisions.
//   • eventType is a plain String (validated at the Zod layer, not a
//     Postgres enum) so new event types can be added without a migration.
//   • No cross-schema FKs — sessionId is opaque client-generated.
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["crm_assistant"]
}

// ─── AssistantEvent (site-wide assistant telemetry) ───────────

model AssistantEvent {
  id        String   @id @default(uuid())
  sessionId String
  turnId    String?
  eventType String
  tool      String?
  route     String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([sessionId, turnId])
  @@index([createdAt])
  @@schema("crm_assistant")
}

// ─── ManagementLastSeen (Management copilot delta window) ─────
// Server-authoritative per-actor/page/scope last-seen timestamp, so the
// `since=last_visit` delta is correct across devices/sessions (the client's
// local lastSeenAt is only a display hint). Not a chat transcript — this is
// the only server-side client state the copilot keeps.

model ManagementLastSeen {
  id               String   @id @default(uuid())
  actorId          String
  pageKey          String
  scopeFingerprint String
  lastSeenAt       DateTime
  updatedAt        DateTime @updatedAt

  @@unique([actorId, pageKey, scopeFingerprint])
  @@index([actorId])
  @@schema("crm_assistant")
}

// ─── InsightState (per-insight acknowledgement and novelty) ───
// Generalizes ManagementLastSeen from "when did this operator last look at this
// scope" to "when did they last see THIS insight, and has it changed since".
// Suppression needs the second question answered: a scope-level timestamp cannot
// tell an unchanged repeat from news.
//
// `lastMaterialValue` is what makes novelty honest. Without it, suppression
// either hides an insight forever or re-shows it on every load; with it, "changed"
// means the insight's own value moved (an amount, a count of days, a status),
// not that time passed.
//
// Keyed on `insightKey`, which comes from src/insights/keys.js and survives a
// descriptor reorder. Keying on the legacy index-prefixed id would have baked a
// developer's array order into stored state.
model InsightState {
  id                String    @id @default(uuid())
  actorId           String
  pageKey           String
  scopeFingerprint  String
  insightKey        String
  firstSeenAt       DateTime  @default(now())
  lastSurfacedAt    DateTime?
  surfacedCount     Int       @default(0)
  acknowledgedAt    DateTime?
  snoozedUntil      DateTime?
  lastMaterialValue String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([actorId, pageKey, scopeFingerprint, insightKey])
  @@index([actorId, pageKey])
  @@schema("crm_assistant")
}

// ─── InsightDecision (why the panel shows what it shows) ───
// One row per candidate that got past the structural layers. A dropped insight
// is a recorded fact with a reason code, not a silent filter, which is what makes
// "why is this not showing" answerable at all.
//
// L0-L2 drops (bad shape, no citation, unauthorized) are deliberately NOT stored
// per row: they are structural and would swamp the table with noise. They belong
// in aggregate counters. The volume decision is recorded in the ranking design
// (PERF-2/3A) and enforced by `decisionsWorthPersisting`.
//
// No foreign keys and no joins, same as AssistantEvent: this is a log, addressed
// by ids that may refer to rows in other services' schemas.
model InsightDecision {
  id               String   @id @default(uuid())
  requestId        String?
  actorId          String
  pageKey          String
  scopeFingerprint String
  insightKey       String
  ruleId           String?
  entityKind       String?
  entityId         String?
  severity         String
  rankScore        Float?
  decision         String
  reason           String
  rankingVersion   String?
  createdAt        DateTime @default(now())

  @@index([actorId, pageKey, createdAt])
  @@index([requestId])
  @@schema("crm_assistant")
}
