# All services share this single PostgreSQL database.
# Each service operates within its own schema namespace.
DATABASE_URL="postgresql://user:password@localhost:5432/travel_crm"

PORT=3001
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Dev/test only — never set in production. Skips the salesRep login OTP step
# (useful when local SMTP isn't configured to actually deliver the code).
# Also requires NODE_ENV to not be "production".
SKIP_OTP=false
