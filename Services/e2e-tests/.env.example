# Copy to .env and fill in before running `npm test`.

# Must point at a LOCAL Gateway. global-setup.js refuses to run against
# anything that doesn't look like localhost/127.0.0.1, and against any
# URL matching a production-looking pattern (api.lushtravelcloud.com, *prod*).
GATEWAY_URL=http://localhost:3000/api/v1

# There is no disposable test database in this repo — every Prisma service
# (plus analytics/notification) points at ONE shared live Supabase Postgres
# instance. This suite creates real rows there (tagged and cleaned up
# automatically, see helpers/test-data-cleanup.js), so this flag exists to
# make you stop and confirm you know that before running it.
# Must be the literal string "true" to proceed.
E2E_I_UNDERSTAND_SHARED_DB=true
