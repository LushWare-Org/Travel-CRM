# All services share this single PostgreSQL database.
# Each service operates within its own schema namespace.
DATABASE_URL="postgresql://user:password@localhost:5432/travel_crm"

PORT=3003
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
GEMINI_API_KEY=your_gemini_api_key
# Optional — defaults to gemini-3.5-flash if unset. Pinned to a specific,
# already-established GA model rather than the floating gemini-flash-latest
# alias: '-latest' can point at a brand-new preview release with a very low
# free-tier quota and availability issues. Re-check this pin periodically as
# newer models mature.
# GEMINI_MODEL=gemini-3.5-flash

# Used to fetch the org's configured branding (company name, tagline, logo,
# address, contact) for the package PDF's header/footer/letterhead (falls
# back to the static defaults below if unreachable).
USER_SERVICE_URL=http://localhost:3002
# Must match user-service's INTERNAL_SERVICE_KEY
INTERNAL_SERVICE_KEY=change-me

# Fallback values used only when user-service can't be reached and there's
# no cached response yet — normally these come from Organization Settings.
# COMPANY_NAME=Travel CRM
# COMPANY_TAGLINE=Your Travel Partner
# COMPANY_LOGO=
# COMPANY_ADDRESS=
# COMPANY_PHONE=
# COMPANY_EMAIL=
# COMPANY_WEBSITE=
# QUOTATION_RATING_TAGLINE=Rated 4.9  |  10k+ Travellers  |  30+ Destinations
