// =============================================================
// package-service — PostgreSQL schema: "packages"
// Shared DB, isolated namespace.
//
// Design decisions:
//   • Itinerary.days and CustomizedPackage.days → Json (JSONB):
//     deeply nested, always read/written as a whole unit.
//   • String arrays (inclusions, exclusions, etc.) → text[].
//   • Cross-schema refs are plain UUID strings (no FK across
//     schema boundaries — enforced at service layer).
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["crm_packages"]
}

enum PackageCategory {
  honeymoon
  couple
  family
  group
  wild_safari @map("wild safari")

  @@schema("crm_packages")
}

enum PackageType {
  Standard
  Deluxe
  Luxury
  Premium

  @@schema("crm_packages")
}

enum PackageStatus {
  draft
  published
  archived

  @@schema("crm_packages")
}

enum ItineraryStatus {
  draft
  published
  archived

  @@schema("crm_packages")
}

enum CpDifficulty {
  easy
  moderate
  difficult

  @@schema("crm_packages")
}

enum CpCategory {
  honeymoon
  family
  adventure
  budget
  luxury
  religious
  wildlife
  beach
  heritage
  other

  @@schema("crm_packages")
}

// ─── Package ──────────────────────────────────────────────────

model Package {
  id                  String          @id @default(uuid())
  name                String?         @db.VarChar(100)
  slug                String?         @unique
  description         String?         @db.VarChar(2000)
  destination         String?
  duration            Int?
  price               Float?
  maxGroupSize        Int             @default(10)
  difficulty          String?
  category            PackageCategory @default(family)
  packageType         PackageType     @default(Standard)

  coverImagePublicId  String?
  coverImageUrl       String?

  inclusions          String[]
  exclusions          String[]
  highlights          String[]
  terms               String[]

  // FK within same schema — constraint enforced
  itineraryId         String?         @unique
  itinerary           Itinerary?      @relation(fields: [itineraryId], references: [id], onDelete: SetNull)

  isActive            Boolean         @default(true)
  isFeatured          Boolean         @default(false)
  status              PackageStatus   @default(draft)
  availableFrom       DateTime        @default(now())
  availableTo         DateTime?

  rating              Float           @default(0)
  numReviews          Int             @default(0)
  views               Int             @default(0)
  bookings            Int             @default(0)

  // Cross-schema UUID refs (no FK constraints)
  createdById         String?         // → users.User.id
  customizedForLeadId String?         // → leads.Lead.id
  originalPackageId   String?         // → packages.Package.id (self-ref for copies)
  customizedById      String?         // → users.User.id
  customizationNotes  String?         @db.VarChar(500)

  images              PackageImage[]
  reviews             Review[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([category])
  @@index([destination])
  @@index([isActive])
  @@index([isFeatured])
  @@index([status])
  @@index([createdById])
  @@index([price])
  @@index([rating])
  @@index([bookings])
  @@index([createdAt])
  @@index([customizedForLeadId])
  @@index([originalPackageId])
  @@index([isActive, category])
  @@index([isActive, isFeatured])
  @@index([isActive, status])
  @@schema("crm_packages")
}

model PackageImage {
  id        String  @id @default(uuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  publicId  String?
  url       String?
  order     Int     @default(0)

  @@index([packageId])
  @@schema("crm_packages")
}

// ─── Itinerary ────────────────────────────────────────────────

model Itinerary {
  id               String          @id @default(uuid())
  packageId        String?
  packageModelType String          @default("Package") // "Package" | "CustomizedPackage"

  // JSONB — deeply nested day objects, always read/written as a whole.
  // Shape per element: { dayNumber, title, description, locations[],
  //   activities[], accommodation{name,type,rating,address,contactNumber},
  //   meals{breakfast,lunch,dinner}, transport,
  //   places[{name,description,duration,images[{public_id,url}]}],
  //   images[{public_id,url}], notes }
  days             Json            @default("[]")

  status           ItineraryStatus @default(draft)
  version          Int             @default(1)

  // Computed metadata (mirrors Mongoose pre-save hook logic)
  metaTotalActivities  Int         @default(0)
  metaTotalLocations   Int         @default(0)
  metaTotalPlaces      Int         @default(0)
  metaBreakfastCount   Int         @default(0)
  metaLunchCount       Int         @default(0)
  metaDinnerCount      Int         @default(0)
  metaLastModifiedById String?     // → users.User.id

  createdById      String?         // → users.User.id

  package          Package?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([packageId])
  @@index([status, createdAt])
  @@index([createdById])
  @@schema("crm_packages")
}

// ─── ManualItinerary ──────────────────────────────────────────

model ManualItinerary {
  id               String          @id @default(uuid())
  leadId           String          // cross-schema ref → leads.Lead.id

  // JSONB — same shape as Itinerary.days
  days             Json            @default("[]")

  status           ItineraryStatus @default(draft)
  version          Int             @default(1)

  metaTotalActivities  Int         @default(0)
  metaTotalLocations   Int         @default(0)
  metaTotalPlaces      Int         @default(0)
  metaBreakfastCount   Int         @default(0)
  metaLunchCount       Int         @default(0)
  metaDinnerCount      Int         @default(0)
  metaLastModifiedById String?

  createdById      String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([leadId, createdAt])
  @@index([status, createdAt])
  @@index([createdById])
  @@schema("crm_packages")
}

// ─── CustomizedPackage ────────────────────────────────────────

model CustomizedPackage {
  id                    String       @id @default(uuid())
  customizationSequence Int          @default(1)
  name                  String       @db.VarChar(100)
  description           String       @db.VarChar(2000)
  destination           String
  duration              Int
  price                 Float
  maxGroupSize          Int          @default(10)
  difficulty            CpDifficulty @default(moderate)
  category              CpCategory   @default(other)

  coverImagePublicId    String?
  coverImageUrl         String?

  inclusions            String[]
  exclusions            String[]
  highlights            String[]
  terms                 String[]

  itineraryId           String?      // → packages.Itinerary.id (same schema)

  // JSONB — inline day data (same shape as Itinerary.days)
  days                  Json         @default("[]")

  isActive              Boolean      @default(true)
  isFeatured            Boolean      @default(false)
  availableFrom         DateTime     @default(now())
  availableTo           DateTime?
  rating                Float        @default(0)
  numReviews            Int          @default(0)
  views                 Int          @default(0)
  bookings              Int          @default(0)

  // Cross-schema UUID refs
  createdById           String?      // → users.User.id
  customizedForLeadId   String       // → leads.Lead.id
  originalPackageId     String       // → packages.Package.id
  customizedById        String       // → users.User.id
  customizationNotes    String?      @db.VarChar(500)

  images                CustomizedPackageImage[]

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([customizedForLeadId])
  @@index([originalPackageId])
  @@index([customizedById])
  @@index([createdAt])
  @@index([isActive])
  @@schema("crm_packages")
}

model CustomizedPackageImage {
  id                  String            @id @default(uuid())
  customizedPackageId String
  package             CustomizedPackage @relation(fields: [customizedPackageId], references: [id], onDelete: Cascade)
  publicId            String?
  url                 String?
  order               Int               @default(0)

  @@index([customizedPackageId])
  @@schema("crm_packages")
}

// ─── Review ───────────────────────────────────────────────────

model Review {
  id         String   @id @default(uuid())
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  authorId   String?  // cross-schema ref → users.User.id (null = guest review)
  name       String
  email      String?
  rating     Int      // 1–5, validated in service layer
  comment    String   @db.VarChar(1000)
  isApproved Boolean  @default(true)
  helpful    Int      @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([packageId, createdAt])
  @@schema("crm_packages")
}

// ─── HotelBooking ─────────────────────────────────────────────

enum HotelBookingStatus {
  pending
  confirmed
  cancelled
  failed

  @@schema("crm_packages")
}

model HotelBooking {
  id                String              @id @default(uuid())
  liteapiBookingId  String?
  hotelId           String
  hotelName         String
  hotelAddress      String?
  hotelImage        String?
  checkin           DateTime
  checkout          DateTime
  currency          String              @default("USD")
  totalAmount       Float
  status            HotelBookingStatus  @default(pending)
  createdById       String              // agent who booked — cross-schema ref → users.User
  customerId        String?             // cross-schema ref → users.User
  guestInfo         Json                // [{ firstName, lastName, title }]
  roomDetails       Json                // { roomType, boardType, ... }
  searchSnapshot    Json                // raw offer at booking time
  cancellationReason String?
  cancelledAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([createdById, createdAt])
  @@index([status])
  @@schema("crm_packages")
}
