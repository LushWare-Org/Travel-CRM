// =============================================================
// package-service — PostgreSQL schema: "packages"
// Shared DB, isolated namespace.
//
// Design decisions:
//   • Relational day model — Itinerary_Day + junction tables
//     replace the old JSONB blob for itemized pricing.
//   • Place + Activity_Catalog are master dictionaries shared
//     across all packages (create-or-select pattern).
//   • Cross-schema refs are plain UUID strings (no FK across
//     schema boundaries — enforced at service layer).
//   • base_price is the cached vendor-cost total, computed by
//     the shared pricing engine; admin may override.
//   • CustomizedPackage + ManualItinerary removed — those are
//     lead-service responsibilities.
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["crm_packages"]
}

// ─── Enums ─────────────────────────────────────────────────────

enum PackageCategory {
  HONEYMOON
  COUPLE
  FAMILY
  GROUP
  WILD_SAFARI

  @@schema("crm_packages")
}

enum MarginType {
  PERCENTAGE
  FIXED

  @@schema("crm_packages")
}

enum PlaceType {
  CITY
  ATTRACTION
  REGION
  AIRPORT

  @@schema("crm_packages")
}

enum RouteType {
  DAILY_ROUTING
  POINT_TO_POINT

  @@schema("crm_packages")
}

enum TransportMode {
  FLIGHT
  CAR
  TRAIN
  BOAT
  VAN
  BUS

  @@schema("crm_packages")
}

enum PricingModel {
  PER_KM
  PER_PERSON
  PER_VEHICLE

  @@schema("crm_packages")
}

enum HotelBookingStatus {
  pending
  confirmed
  cancelled
  failed

  @@schema("crm_packages")
}

// ─── Package (core blueprint) ──────────────────────────────────

model Package {
  id                  String          @id @default(uuid())
  title               String          @default("") @db.VarChar(255)
  slug                String?         @unique
  description         String?         @db.Text
  destination         String?         @db.VarChar(255)   // denormalized search/filter aid
  durationDays        Int             @default(1) @map("duration_days")
  category            PackageCategory @default(FAMILY)
  coverImage          String?         @db.VarChar(500)   @map("cover_image")

  inclusions          Json            @default("[]")      // string[]
  exclusions          Json            @default("[]")      // string[]
  termsAndConditions  String?         @db.Text            @map("terms_and_conditions")

  basePrice           Decimal         @default(0)         @map("base_price") @db.Decimal(10, 2)
  defaultMarginType   MarginType      @default(PERCENTAGE) @map("default_margin_type")
  defaultMarginInput  Decimal         @default(0)         @map("default_margin_input") @db.Decimal(10, 2)
  currency            String          @default("USD")     @db.VarChar(3)

  isActive            Boolean         @default(true)      @map("is_active")
  isFeatured          Boolean         @default(false)     @map("is_featured")

  rating              Float           @default(0)
  numReviews          Int             @default(0)         @map("num_reviews")
  views               Int             @default(0)
  bookings            Int             @default(0)

  // Cross-schema ref (no FK across schema boundaries)
  createdBy           String?                             @map("created_by")   // → users.User.id

  images              PackageImage[]
  itineraryDays       ItineraryDay[]
  reviews             Review[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([category])
  @@index([destination])
  @@index([isActive])
  @@index([isFeatured])
  @@index([createdBy])
  @@index([basePrice])
  @@index([rating])
  @@index([bookings])
  @@index([createdAt])
  @@index([isActive, category])
  @@index([isActive, isFeatured])
  @@schema("crm_packages")
}

// ─── Package Image ─────────────────────────────────────────────

model PackageImage {
  id         String   @id @default(uuid())
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  url        String?
  altText    String?  @db.VarChar(255)  @map("alt_text")
  orderIndex Int      @default(0)       @map("order_index")

  @@index([packageId])
  @@map("Package_Image")
  @@schema("crm_packages")
}

// ─── Itinerary Day (daily container) ───────────────────────────

model ItineraryDay {
  id                String   @id @default(uuid())
  packageId         String
  package           Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  dayNumber         Int      @map("day_number")
  title             String?  @db.VarChar(255)
  description       String?  @db.Text

  breakfastCount    Int      @default(0) @map("breakfast_count")
  lunchCount        Int      @default(0) @map("lunch_count")
  dinnerCount       Int      @default(0) @map("dinner_count")
  mealPriceOverride Decimal? @map("meal_price_override") @db.Decimal(10, 2)
  flights           Json     @default("[]") // editor flight preferences per day

  places            PackageDayPlace[]
  activities        PackageDayActivity[]
  transports        PackageDayTransport[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([packageId, dayNumber])
  @@index([packageId])
  @@map("Itinerary_Day")
  @@schema("crm_packages")
}

// ─── Place (master dictionary) ─────────────────────────────────

model Place {
  id          String     @id @default(uuid())
  name        String     @unique @db.VarChar(255)
  type        PlaceType
  defaultCost Decimal?   @map("default_cost") @db.Decimal(10, 2)

  dayPlaces   PackageDayPlace[]
  origins     PackageDayTransport[]  @relation("TransportOrigin")
  destinations PackageDayTransport[] @relation("TransportDestination")

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([type])
  @@schema("crm_packages")
}

// ─── Package Day Place (junction) ─────────────────────────────

model PackageDayPlace {
  id             String       @id @default(uuid())
  itineraryDayId String
  itineraryDay   ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  placeId        String?
  place          Place?       @relation(fields: [placeId], references: [id], onDelete: SetNull)
  customName     String?      @db.VarChar(255)  @map("custom_name")
  orderIndex     Int          @default(0)       @map("order_index")

  @@unique([itineraryDayId, orderIndex])
  @@index([itineraryDayId])
  @@index([placeId])
  @@map("Package_Day_Place")
  @@schema("crm_packages")
}

// ─── Activity Catalog (master dictionary) ──────────────────────

model ActivityCatalog {
  id          String              @id @default(uuid())
  name        String              @unique @db.VarChar(255)
  description String?             @db.Text
  defaultCost Decimal             @map("default_cost") @db.Decimal(10, 2)
  vendorId    String?             @map("vendor_id")  // cross-schema ref → users.User.id

  dayActivities PackageDayActivity[]

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("Activity_Catalog")
  @@schema("crm_packages")
}

// ─── Package Day Activity (junction) ───────────────────────────

model PackageDayActivity {
  id             String          @id @default(uuid())
  itineraryDayId String
  itineraryDay   ItineraryDay    @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  activityId     String
  activity       ActivityCatalog @relation(fields: [activityId], references: [id], onDelete: Cascade)
  orderIndex     Int             @default(0)      @map("order_index")
  costOverride   Decimal?        @map("cost_override") @db.Decimal(10, 2)

  @@unique([itineraryDayId, orderIndex])
  @@index([itineraryDayId])
  @@index([activityId])
  @@map("Package_Day_Activity")
  @@schema("crm_packages")
}

// ─── Package Day Transport ─────────────────────────────────────

model PackageDayTransport {
  id                 String        @id @default(uuid())
  itineraryDayId     String
  itineraryDay       ItineraryDay  @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  routeType          RouteType     @map("route_type")
  transportMode      TransportMode @map("transport_mode")
  pricingModel       PricingModel  @map("pricing_model")
  unitCost           Decimal       @map("unit_cost") @db.Decimal(10, 2)
  distanceKm         Decimal?      @map("distance_km") @db.Decimal(8, 2)
  originPlaceId      String?       @map("origin_place_id")
  originPlace        Place?        @relation("TransportOrigin", fields: [originPlaceId], references: [id], onDelete: SetNull)
  destinationPlaceId String?       @map("destination_place_id")
  destinationPlace   Place?        @relation("TransportDestination", fields: [destinationPlaceId], references: [id], onDelete: SetNull)

  @@index([itineraryDayId])
  @@map("Package_Day_Transport")
  @@schema("crm_packages")
}

// ─── Review (unchanged) ────────────────────────────────────────

model Review {
  id         String   @id @default(uuid())
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  authorId   String?  // cross-schema ref → users.User.id (null = guest review)
  name       String
  email      String?
  rating     Int      // 1–5, validated in service layer
  comment    String   @db.VarChar(1000)
  isApproved Boolean  @default(true)
  helpful    Int      @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([packageId, createdAt])
  @@schema("crm_packages")
}

// ─── HotelBooking (unchanged) ──────────────────────────────────

model HotelBooking {
  id                String              @id @default(uuid())
  liteapiBookingId  String?
  hotelId           String
  hotelName         String
  hotelAddress      String?
  hotelImage        String?
  checkin           DateTime
  checkout          DateTime
  currency          String              @default("USD")
  totalAmount       Float
  status            HotelBookingStatus  @default(pending)
  createdById       String              // agent who booked — cross-schema ref → users.User
  customerId        String?             // cross-schema ref → users.User
  guestInfo         Json                // [{ firstName, lastName, title }]
  roomDetails       Json                // { roomType, boardType, ... }
  searchSnapshot    Json                // raw offer at booking time
  cancellationReason String?
  cancelledAt       DateTime?

  // Booking reference fields
  supplierPortalUrl  String?
  pnrCode            String?

  // Lead / day context — cross-schema UUID refs
  leadId              String?
  packageId           String?
  customizedPackageId String?   // kept for historical data; no FK
  dayNumber           Int?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([createdById, createdAt])
  @@index([status])
  @@index([leadId])
  @@index([leadId, dayNumber])
  @@schema("crm_packages")
}
