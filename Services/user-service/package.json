{
  "name": "@travel-crm/user-service",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:generate": "npx prisma@5 generate",
    "db:push": "npx prisma@5 db push",
    "db:migrate": "npx prisma@5 migrate dev",
    "db:migrate:deploy": "npx prisma@5 migrate deploy",
    "db:migrate:status": "npx prisma@5 migrate status",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run test/"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@travel-crm/contracts": "file:../shared/contracts",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "nodemon": "^3.1.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.0"
  }
}
