// =============================================================
// user-service — PostgreSQL schema: "users"
// Shared DB, isolated namespace. VendorProfile is a 1:1
// extension of User, only populated when role = vendor.
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["users"]
}

enum UserRole {
  customer
  salesRep
  vendor
  admin
  superAdmin

  @@schema("users")
}

enum VendorStatus {
  pending_verification
  verified
  suspended
  rejected

  @@schema("users")
}

enum ServiceType {
  hotel
  transport
  activity
  restaurant
  guide
  other

  @@schema("users")
}

// Valid permission strings (validated in service layer, stored as text[]):
// manage_users | manage_sales_reps | manage_vendors | manage_admins
// view_reports | manage_billing | view_billing | manage_leads | manage_packages

model User {
  id                       String         @id @default(uuid())
  name                     String         @db.VarChar(50)
  email                    String         @unique @db.VarChar(255)
  phone                    String?
  phoneCountry             String?        @default("US") @db.VarChar(2)
  phoneE164                String?        @unique
  password                 String         // bcrypt hash — never exposed in API responses

  role                     UserRole       @default(customer)
  isSuperAdmin             Boolean        @default(false)
  permissions              String[]       // validated against allowed list in service layer

  avatarPublicId           String?
  avatarUrl                String?

  isActive                 Boolean        @default(true)
  isEmailVerified          Boolean        @default(false)
  isTempPassword           Boolean        @default(false)
  mustChangePassword       Boolean        @default(false)
  canBeDeleted             Boolean        @default(true)

  passwordChangedAt        DateTime?
  emailVerificationToken   String?
  emailVerificationExpire  DateTime?
  resetPasswordToken       String?
  resetPasswordExpire      DateTime?
  lastLogin                DateTime?
  lastActivity             DateTime       @default(now())

  // Self-referential within this schema
  createdById              String?
  createdBy                User?          @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers             User[]         @relation("UserCreatedBy")

  vendorProfile            VendorProfile?

  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([role, isActive])
  @@index([lastActivity])
  @@schema("users")
}

model VendorProfile {
  id                          String       @id @default(uuid())
  userId                      String       @unique
  user                        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName                String?
  serviceType                 ServiceType?
  businessRegistrationNumber  String?      @unique
  taxIdentificationNumber     String?

  // Address (flattened from Mongoose embedded object)
  addressStreet               String?
  addressCity                 String?
  addressState                String?
  addressZipCode              String?
  addressCountry              String?

  // Contact person (flattened)
  contactPersonName           String?
  contactPersonPhone          String?
  contactPersonEmail          String?
  contactPersonDesignation    String?

  // Bank details (flattened)
  bankAccountName             String?
  bankAccountNumber           String?
  bankName                    String?
  bankBranchName              String?
  bankIfscCode                String?
  bankSwiftCode               String?

  rating                      Float        @default(0)
  totalBookings               Int          @default(0)
  vendorStatus                VendorStatus @default(pending_verification)

  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  @@schema("users")
}
