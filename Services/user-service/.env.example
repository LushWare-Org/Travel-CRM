# All services share this single PostgreSQL database.
# Each service operates within its own schema namespace.
DATABASE_URL="postgresql://user:password@localhost:5432/travel_crm"

PORT=3002

# Shared secret checked on GET /api/v1/admin/internal/organization-settings
# (x-internal-token header) — service-to-service only, never reached through
# the gateway. Must match billing-service's INTERNAL_SERVICE_KEY.
INTERNAL_SERVICE_KEY=change-me
