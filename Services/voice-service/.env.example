# Supabase PostgreSQL — same instance as every other service, own schema (crm_voice)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

PORT=3012
NODE_ENV=development
LOG_LEVEL=info
CLIENT_URL=http://localhost:5173
MANAGEMENT_URL=http://localhost:5174

# Domain services this service calls while handling a call. Reach them through
# their own ports (the gateway is not in this path) — except the webhooks, which
# arrive through the gateway at /api/v1/webhooks/voice/*.
LEAD_SERVICE_URL=http://localhost:3004
PACKAGE_SERVICE_URL=http://localhost:3003
BILLING_SERVICE_URL=http://localhost:3006
USER_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3008
# Only test-voice-agent.mjs uses this one: it drives the tool endpoints the way
# Retell will, i.e. through the gateway.
# GATEWAY_URL=http://localhost:3000

# Must match the values the services above use.
INTERNAL_SERVICE_KEY=change-me-internal-key
INTERNAL_EVENTS_TOKEN=shared_internal_service_token

# ─── Retell AI ─────────────────────────────────────────────────────────────
# Signing secret from the Retell dashboard (Webhooks → your endpoint). Required
# in every environment: without it the webhook routes answer 503 and every tool
# call is rejected — there is deliberately no development bypass, because these
# routes sit on the gateway's public allowlist.
RETELL_WEBHOOK_SECRET=your-retell-signing-secret

# Shared secret the CustomTools carry in their own `headers` field, checked
# instead of a signature (Retell documents no signature for tool calls). Falls
# back to RETELL_WEBHOOK_SECRET when unset, which is what setup-voice-agent.mjs
# registers when this is absent.
# RETELL_TOOL_SECRET=

# Read by `node setup-voice-agent.mjs` / `node setup-voice-number.mjs`, which
# push the prompt and register the number. Not read by the service itself.
RETELL_AGENT_ID=agent_xxxxxxxxxxxx
RETELL_PHONE_NUMBER=+94112345678
# Public HTTPS base URL this service is reachable at (the environment's gateway
# host). setup-voice-agent.mjs uses it to register the seven CustomTool
# endpoints; without it the script prints them for manual entry instead.
# RETELL_PUBLIC_BASE_URL=https://dev-gateway-xxxxxxxx-el.a.run.app

# Calls from one number this service will act on per rolling 24h (default 20).
# Past the cap the call is still answered and still recorded in full — it just
# stops being forwarded into lead-service/notification-service.
VOICE_MAX_CALLS_PER_NUMBER_PER_DAY=20
