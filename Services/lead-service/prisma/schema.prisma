// =============================================================
// lead-service — PostgreSQL schema: "leads"
// Shared DB, isolated namespace.
//
// Design decisions (2026-08-02 rebuild):
//   • Lifecycle is driven by lifecycleStatus; the legacy `status` enum and
//     LeadStatusOption table are removed.
//   • The package blueprint is copied once (NEW → DRAFTING) into lead-owned
//     itinerary tables (LeadItineraryDay + children) with snapshotted prices.
//   • Pricing is relational: LeadPricing (currency, margin, deposit plan,
//     computed totals) + LeadCostLine[] (basis, est/actual, margin override,
//     source AUTO|MANUAL).
//   • Optional transfer flights are LeadOptionalFlight rows (pricing + state).
//   • Cross-schema refs are plain UUID strings (no FK across schemas).
//   • Enum values mirror @travel-crm/constants (asserted by tests).
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["crm_leads"]
}

// ─── Enums ─────────────────────────────────────────────────────

enum LeadSource {
  manual
  website
  booking
  social_media @map("social-media")
  phone_call   @map("phone-call")
  email
  referral
  walk_in      @map("walk-in")
  other

  @@schema("crm_leads")
}

enum LeadPlatform {
  Manual_Entry @map("Manual Entry")
  Website_Form @map("Website Form")
  Paid_Package @map("Paid Package")
  Social_Media @map("Social Media")
  Phone_Call   @map("Phone Call")
  Email        @map("Email")
  Referral     @map("Referral")
  Walk_in      @map("Walk-in")

  @@schema("crm_leads")
}

enum LeadLifecycleStatus {
  NEW
  DRAFTING
  QUOTED
  REVISION
  APPROVED
  BOOKING_IN_PROGRESS
  CONFIRMED
  CLOSED_LOST
  BOOKING_FAILED
  CANCELLED

  @@schema("crm_leads")
}

enum LeadPriority {
  low
  medium
  high

  @@schema("crm_leads")
}

enum AssignmentMode {
  manual
  auto

  @@schema("crm_leads")
}

enum AssignmentStrategy {
  round_robin
  load_based

  @@schema("crm_leads")
}

enum CommunicationLogType {
  call
  email
  meeting
  message
  other

  @@schema("crm_leads")
}

// ─── Pricing enums (mirror @travel-crm/constants) ──────────────

enum PricingBasis {
  PER_PERSON
  PER_ROOM
  PER_VEHICLE
  PER_KM
  FIXED

  @@schema("crm_leads")
}

enum MarginType {
  PERCENTAGE
  FIXED

  @@schema("crm_leads")
}

enum CostLineSource {
  AUTO
  MANUAL

  @@schema("crm_leads")
}

enum OptionalFlightType {
  TO_START
  RETURN_HOME

  @@schema("crm_leads")
}

enum StatusHistoryActor {
  USER
  SYSTEM

  @@schema("crm_leads")
}

enum DiscountType {
  none
  percentage
  fixed

  @@schema("crm_leads")
}

enum CostLineCategory {
  accommodation
  transportation
  activity
  food
  guide
  insurance
  visa
  package
  other

  @@schema("crm_leads")
}

// ─── Lead ──────────────────────────────────────────────────────

model Lead {
  id                 String       @id @default(uuid())
  name               String?
  email              String?
  phone              String?
  whatsapp           String?
  city               String?
  source             LeadSource   @default(manual)
  platform           LeadPlatform @default(Manual_Entry)
  fromCountry        String?
  destinationCountry String?
  destination        String?
  travelDate         DateTime?
  endDate            DateTime?

  // Cross-schema UUID refs
  packageId          String? // → packages.Package.id
  convertedBookingId String? // → bookings.Booking.id
  currentItineraryId String? // → packages.Itinerary.id (editor ref)
  packageName        String? // denormalised snapshot for display
  // packageId this lead's itineraryDays/costLines were last generated from,
  // verbatim (no manual edits since). Null once the itinerary is customized.
  // Used to decide whether switching packages can safely replace the itinerary.
  sourcePackageId    String?
  leadDateTime       DateTime @default(now())
  numberOfTravelers  Int?
  budget             String?
  message            String?

  lifecycleStatus LeadLifecycleStatus @default(NEW)
  priority        LeadPriority        @default(medium)

  // Cross-schema UUID refs
  assignedToId   String? // → users.User.id (salesRep)
  assignedById   String? // → users.User.id (admin/auto)
  assignmentMode AssignmentMode @default(manual)

  // Quotation handoff (billing-service)
  currentQuoteId  String? // → billing.Quotation.id
  quoteAcceptedAt DateTime?

  // Notification preferences
  notifNewLead      Boolean @default(true)
  notifStatusChange Boolean @default(true)
  notifAssignment   Boolean @default(true)
  notifFollowUp     Boolean @default(true)

  followUpDate DateTime?
  lostReason   String?
  tags         String[]

  pricing         LeadPricing?
  costLines       LeadCostLine[]
  itineraryDays   LeadItineraryDay[]
  optionalFlights LeadOptionalFlight[]

  remarks           LeadRemark[]
  statusHistory     LeadStatusHistory[]
  communicationLogs LeadCommunicationLog[]
  internalEvents    LeadInternalEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lifecycleStatus, createdAt])
  @@index([assignedToId, lifecycleStatus, createdAt])
  @@index([followUpDate])
  @@index([source, createdAt])
  @@index([platform])
  @@index([fromCountry, destinationCountry])
  @@index([leadDateTime])
  @@index([assignmentMode])
  @@index([city])
  @@index([currentQuoteId])
  @@schema("crm_leads")
}

// ─── Lead child tables ─────────────────────────────────────────

model LeadRemark {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  text      String?
  addedById String? // → users.User.id
  date      DateTime @default(now())
  addedAt   DateTime @default(now())

  @@index([leadId])
  @@schema("crm_leads")
}

model LeadStatusHistory {
  id          String             @id @default(uuid())
  leadId      String
  lead        Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status      String
  actor       StatusHistoryActor @default(USER)
  changedById String? // → users.User.id
  changedAt   DateTime           @default(now())
  notes       String?

  @@index([leadId])
  @@schema("crm_leads")
}

model LeadCommunicationLog {
  id     String                @id @default(uuid())
  leadId String
  lead   Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  date   DateTime              @default(now())
  type   CommunicationLogType?
  notes  String?
  byId   String? // → users.User.id

  @@index([leadId])
  @@schema("crm_leads")
}

// ─── Internal event log (billing → lead webhooks) ─────────────

model LeadInternalEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String
  payload     Json?
  processedAt DateTime @default(now())

  @@index([leadId])
  @@schema("crm_leads")
}

// ─── Pricing (relational) ──────────────────────────────────────

model LeadPricing {
  id     String @id @default(uuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  currency String @default("USD") @db.VarChar(3)

  marginType        MarginType?
  marginValue       Decimal?     @db.Decimal(12, 2)
  depositType       MarginType?
  depositValue      Decimal?     @db.Decimal(12, 2)
  discountType      DiscountType @default(none)
  discountValue     Decimal      @default(0) @db.Decimal(12, 2)
  serviceChargeRate Decimal      @default(0) @db.Decimal(12, 2)

  estimatedTotal      Decimal  @default(0) @db.Decimal(12, 2)
  actualTotal         Decimal? @db.Decimal(12, 2)
  sellSubtotal        Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount      Decimal  @default(0) @db.Decimal(12, 2)
  taxableSubtotal     Decimal  @default(0) @db.Decimal(12, 2)
  taxAmount           Decimal  @default(0) @db.Decimal(12, 2)
  serviceChargeAmount Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal  @default(0) @db.Decimal(12, 2)
  depositAmount       Decimal  @default(0) @db.Decimal(12, 2)
  paidAmount          Decimal  @default(0) @db.Decimal(12, 2)
  balanceDue          Decimal  @default(0) @db.Decimal(12, 2)
  profit              Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("crm_leads")
}

model LeadCostLine {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  category           CostLineCategory
  description        String
  basis              PricingBasis
  quantity           Int              @default(1)
  estimatedUnitPrice Decimal          @default(0) @db.Decimal(12, 2)
  actualUnitPrice    Decimal?         @db.Decimal(12, 2)
  quotedUnitPrice    Decimal          @default(0) @db.Decimal(12, 2)
  estimatedTotal     Decimal          @default(0) @db.Decimal(12, 2)
  actualTotal        Decimal?         @db.Decimal(12, 2)
  sellTotal          Decimal          @default(0) @db.Decimal(12, 2)
  marginType         MarginType?
  marginValue        Decimal?         @db.Decimal(12, 2)
  source             CostLineSource   @default(AUTO)
  dayNumber          Int?
  flightBookingId    String?
  optionalFlightId   String? // → leads.LeadOptionalFlight.id (same schema)
  orderIndex         Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@schema("crm_leads")
}

// ─── Copied itinerary (detached package copy) ──────────────────

model LeadItineraryDay {
  id                String   @id @default(uuid())
  leadId            String
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dayNumber         Int
  title             String?
  description       String?
  breakfastCount    Int      @default(0)
  lunchCount        Int      @default(0)
  dinnerCount       Int      @default(0)
  mealPriceOverride Decimal? @db.Decimal(12, 2)
  accommodation     Json     @default("{}")
  flights           Json     @default("[]")

  places     LeadDayPlace[]
  activities LeadDayActivity[]
  transports LeadDayTransport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadId, dayNumber])
  @@index([leadId])
  @@schema("crm_leads")
}

model LeadDayPlace {
  id                 String           @id @default(uuid())
  leadItineraryDayId String
  leadItineraryDay   LeadItineraryDay @relation(fields: [leadItineraryDayId], references: [id], onDelete: Cascade)
  placeId            String? // → packages.Place.id (snapshot ref)
  customName         String?
  orderIndex         Int              @default(0)

  @@unique([leadItineraryDayId, orderIndex])
  @@index([leadItineraryDayId])
  @@schema("crm_leads")
}

model LeadDayActivity {
  id                 String           @id @default(uuid())
  leadItineraryDayId String
  leadItineraryDay   LeadItineraryDay @relation(fields: [leadItineraryDayId], references: [id], onDelete: Cascade)
  activityId         String? // → packages.ActivityCatalog.id (snapshot ref)
  name               String?
  defaultCost        Decimal?         @db.Decimal(12, 2)
  costOverride       Decimal?         @db.Decimal(12, 2)
  orderIndex         Int              @default(0)

  @@unique([leadItineraryDayId, orderIndex])
  @@index([leadItineraryDayId])
  @@schema("crm_leads")
}

model LeadDayTransport {
  id                 String           @id @default(uuid())
  leadItineraryDayId String
  leadItineraryDay   LeadItineraryDay @relation(fields: [leadItineraryDayId], references: [id], onDelete: Cascade)
  routeType          String?
  transportMode      String?
  pricingModel       String?
  unitCost           Decimal          @default(0) @db.Decimal(12, 2)
  distanceKm         Decimal?         @db.Decimal(8, 2)
  origin             String?
  destination        String?

  @@index([leadItineraryDayId])
  @@schema("crm_leads")
}

// ─── Optional transfer flights ─────────────────────────────────

model LeadOptionalFlight {
  id                 String             @id @default(uuid())
  leadId             String
  lead               Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  flightType         OptionalFlightType
  origin             String?
  destination        String?
  date               DateTime?
  cabinClass         String?
  departureTime      String?
  airlinePreference  String?
  notes              String?
  flightBookingId    String? // → flights.FlightBooking.id
  status             String             @default("PENDING")
  estimatedUnitPrice Decimal            @default(0) @db.Decimal(12, 2)
  actualUnitPrice    Decimal?           @db.Decimal(12, 2)
  quantity           Int                @default(1)
  marginType         MarginType?
  marginValue        Decimal?           @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@schema("crm_leads")
}

// ─── Settings (singleton) ──────────────────────────────────────

model Settings {
  id                    String             @id @default(uuid())
  assignmentMode        AssignmentMode     @default(manual)
  autoStrategy          AssignmentStrategy @default(round_robin)
  enabledSalesRepIds    String[] // → users.User.id[]
  roundRobinIndex       Int                @default(0)
  maxOpenLeadsPerRep    Int                @default(100)
  skipInactive          Boolean            @default(true)
  requireActiveLogin48h Boolean            @default(false)
  updatedById           String? // → users.User.id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Only one row allowed — enforced by getSingleton() in service layer

  @@schema("crm_leads")
}
