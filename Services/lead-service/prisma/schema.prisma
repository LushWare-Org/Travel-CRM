// =============================================================
// lead-service — PostgreSQL schema: "leads"
// Shared DB, isolated namespace.
//
// Design decisions:
//   • Mongoose embedded arrays (remarks, statusHistory,
//     communicationLogs) → proper child tables with FK to Lead.
//   • notificationSettings object → flattened boolean columns.
//   • tags and itineraryVersionIds → text[] arrays.
//   • Settings is a singleton — enforced in service layer.
//   • All cross-schema refs are plain UUID strings.
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["crm_leads"]
}

enum LeadSource {
  manual
  website
  booking
  social_media  @map("social-media")
  phone_call    @map("phone-call")
  email
  referral
  walk_in       @map("walk-in")
  other

  @@schema("crm_leads")
}

enum LeadPlatform {
  Manual_Entry  @map("Manual Entry")
  Website_Form  @map("Website Form")
  Paid_Package  @map("Paid Package")
  Social_Media  @map("Social Media")
  Phone_Call    @map("Phone Call")
  Email         @map("Email")
  Referral      @map("Referral")
  Walk_in       @map("Walk-in")

  @@schema("crm_leads")
}

enum LeadStatus {
  new
  contacted
  interested
  quoted
  converted
  lost
  not_interested @map("not-interested")

  @@schema("crm_leads")
}

enum LeadPriority {
  low
  medium
  high

  @@schema("crm_leads")
}

enum AssignmentMode {
  manual
  auto

  @@schema("crm_leads")
}

enum AssignmentStrategy {
  round_robin
  load_based

  @@schema("crm_leads")
}

enum CommunicationLogType {
  call
  email
  meeting
  message
  other

  @@schema("crm_leads")
}

// ─── Lead ─────────────────────────────────────────────────────

model Lead {
  id                    String       @id @default(uuid())
  name                  String?
  email                 String?
  phone                 String?
  whatsapp              String?
  city                  String?
  salesRep              String?      // legacy free-text field kept for compatibility
  time                  String?
  source                LeadSource   @default(manual)
  platform              LeadPlatform @default(Manual_Entry)
  fromCountry           String?
  destinationCountry    String?
  destination           String?
  travelDate            DateTime?
  endDate               DateTime?

  // Cross-schema UUID refs
  packageId             String?      // → packages.Package.id
  customizedPackageId   String?      // → packages.CustomizedPackage.id
  convertedBookingId    String?      // → bookings.Booking.id

  packageName           String?      // denormalised snapshot for display
  leadDateTime          DateTime     @default(now())
  numberOfTravelers     Int?
  budget                String?
  message               String?

  status                LeadStatus   @default(new)
  priority              LeadPriority @default(medium)

  // Cross-schema UUID refs
  assignedToId          String?      // → users.User.id (salesRep)
  assignedById          String?      // → users.User.id (admin/auto)
  assignmentMode        AssignmentMode @default(manual)

  // Itinerary cross-schema refs
  currentItineraryId    String?      // → packages.Itinerary.id
  manualItineraryId     String?      // → packages.ManualItinerary.id
  itineraryVersionIds   String[]     // → packages.Itinerary.id[]

  // Notification preferences (flattened from Mongoose embedded object)
  notifNewLead          Boolean      @default(true)
  notifStatusChange     Boolean      @default(true)
  notifAssignment       Boolean      @default(true)
  notifFollowUp         Boolean      @default(true)

  followUpDate          DateTime?
  quoteSent             Boolean      @default(false)
  quoteAmount           Float?
  lostReason            String?
  tags                  String[]

  // Optional transfer flights metadata
  // [{ origin, destination, date, flightType: "to-start"|"return-home", flightBookingId, status, flightNumber, carrier, notes }]
  optionalFlights       Json?        @default("[]")

  remarks               LeadRemark[]
  statusHistory         LeadStatusHistory[]
  communicationLogs     LeadCommunicationLog[]

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([assignedToId, status, createdAt])
  @@index([followUpDate])
  @@index([source, createdAt])
  @@index([platform])
  @@index([fromCountry, destinationCountry])
  @@index([leadDateTime])
  @@index([assignmentMode])
  @@index([city])
  @@schema("crm_leads")
}

// ─── Lead child tables ────────────────────────────────────────

model LeadRemark {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  text      String?
  addedById String?  // → users.User.id
  date      DateTime @default(now())
  addedAt   DateTime @default(now())

  @@index([leadId])
  @@schema("crm_leads")
}

model LeadStatusHistory {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status      String
  changedById String?  // → users.User.id
  changedAt   DateTime @default(now())
  notes       String?

  @@index([leadId])
  @@schema("crm_leads")
}

model LeadCommunicationLog {
  id      String                @id @default(uuid())
  leadId  String
  lead    Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  date    DateTime              @default(now())
  type    CommunicationLogType?
  notes   String?
  byId    String?               // → users.User.id

  @@index([leadId])
  @@schema("crm_leads")
}

// ─── LeadStatusOption ─────────────────────────────────────────

model LeadStatusOption {
  id          String   @id @default(uuid())
  statusName  String   @unique
  displayName String
  color       String   @default("#6B7280")
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  description String?
  createdById String?  // → users.User.id

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([isActive])
  @@schema("crm_leads")
}

// ─── Settings (singleton) ─────────────────────────────────────

model Settings {
  id                    String             @id @default(uuid())
  assignmentMode        AssignmentMode     @default(manual)
  autoStrategy          AssignmentStrategy @default(round_robin)
  enabledSalesRepIds    String[]           // → users.User.id[]
  roundRobinIndex       Int                @default(0)
  maxOpenLeadsPerRep    Int                @default(100)
  skipInactive          Boolean            @default(true)
  requireActiveLogin48h Boolean            @default(false)
  updatedById           String?            // → users.User.id

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  // Only one row allowed — enforced by getSingleton() in service layer

  @@schema("crm_leads")
}
