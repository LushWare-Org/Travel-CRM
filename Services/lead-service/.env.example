# All services share this single PostgreSQL database.
# Each service operates within its own schema namespace.
DATABASE_URL="postgresql://user:password@localhost:5432/travel_crm"

PORT=3004
REDIS_URL=redis://localhost:6379

# notification-service — outbound WhatsApp agent replies (POST
# /notifications/internal/whatsapp). Must match notification-service's
# own INTERNAL_EVENTS_TOKEN.
NOTIFICATION_SERVICE_URL=http://localhost:3008
INTERNAL_EVENTS_TOKEN=shared_internal_service_token
