{
  "name": "@travel-crm/lead-service",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:generate": "npx prisma@5 generate",
    "db:push": "npx prisma@5 db push",
    "db:migrate": "npx prisma@5 migrate dev",
    "db:migrate:deploy": "npx prisma@5 migrate deploy",
    "db:migrate:status": "npx prisma@5 migrate status",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run test/",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@travel-crm/contracts": "file:../shared/contracts",
    "@travel-crm/lead-pricing-engine": "file:../shared/lead-pricing-engine",
    "@travel-crm/pricing-engine": "file:../shared/pricing-engine",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "uuid": "^14.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "supertest": "^7.2.0",
    "vitest": "^4.1.0",
    "eslint": "^9.19.0",
    "@eslint/js": "^9.19.0",
    "globals": "^15.14.0"
  }
}
