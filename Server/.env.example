# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/travel-crm
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/travel-crm

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# Cookie Configuration
COOKIE_EXPIRES_IN=7
JWT_COOKIE_EXPIRES_IN=7

# ==========================================
# COMPANY BRANDING (Customize for each client)
# ==========================================
COMPANY_NAME=Your Company Name
COMPANY_SHORT_NAME=YCN
COMPANY_TAGLINE=Your Travel Partner
COMPANY_LEGAL_NAME=Your Company Pvt. Ltd.

# Contact Information
COMPANY_EMAIL=info@yourcompany.com
SUPPORT_EMAIL=support@yourcompany.com
SALES_EMAIL=sales@yourcompany.com
COMPANY_PHONE=+1-800-000-0000
COMPANY_WHATSAPP=+1-800-000-0000

# Website
COMPANY_WEBSITE=https://www.yourcompany.com

# Address
COMPANY_ADDRESS_STREET=Your Street Address
COMPANY_CITY=Your City
COMPANY_STATE=Your State
COMPANY_POSTAL_CODE=000000
COMPANY_COUNTRY=Your Country
COMPANY_FULL_ADDRESS=Your Street Address, Your City, Your State - 000000

# ==========================================
# BANK/PAYMENT DETAILS
# ==========================================
BANK_NAME=Your Bank
BANK_ACCOUNT_NAME=Your Company Name
BANK_ACCOUNT_NUMBER=0000000000
BANK_IFSC_CODE=XXXX0000000
BANK_SWIFT_CODE=
BANK_BRANCH=Main Branch
BANK_ACCOUNT_TYPE=Current Account
UPI_ID=yourcompany@upi
PAYMENT_PHONE=0000000000

# ==========================================
# SOCIAL MEDIA (Optional)
# ==========================================
FACEBOOK_URL=
INSTAGRAM_URL=
TWITTER_URL=
LINKEDIN_URL=
YOUTUBE_URL=

# ==========================================
# LEGAL INFORMATION
# ==========================================
LEGAL_JURISDICTION=India
LEGAL_COURT_LOCATION=Your City
COMPANY_REGISTRATION_NO=
GST_NUMBER=
PAN_NUMBER=

# ==========================================
# EMAIL CONFIGURATION (Nodemailer)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=Your Company
EMAIL_FROM_ADDRESS=noreply@yourcompany.com
EMAIL_REPLY_TO=support@yourcompany.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Payment Gateway Configuration
# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Frontend URLs
CLIENT_URL=http://localhost:5173
MANAGEMENT_URL=http://localhost:5174

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Security
BCRYPT_ROUNDS=12

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Admin Default Credentials (Change after first login)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=Admin@123456
ADMIN_PHONE=0000000000
